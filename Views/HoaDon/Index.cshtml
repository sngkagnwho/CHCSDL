@model IEnumerable<doan.Models.HoaDon>
@{
    ViewData["Title"] = "Danh Sách Hóa Đơn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🧾 Danh Sách Hóa Đơn</h2>
    <a asp-action="Create" class="btn btn-success">+ Tạo Hóa Đơn</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <select name="trangThai" asp-items="@ViewBag.TrangThaiList" class="form-select" style="max-width: 200px;">
        <option value="">-- Tất cả trạng thái --</option>
    </select>
    <button class="btn btn-primary" type="submit">Lọc</button>
    @if (!string.IsNullOrWhiteSpace(ViewBag.TrangThai as string))
    {
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa lọc</a>
    }
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Mã Đặt Phòng</th>
                <th>Khách Hàng</th>
                <th>Ngày Lập</th>
                <th>Tổng Tiền</th>
                <th>Đã Thanh Toán</th>
                <th>Trạng Thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaHoaDon</td>
                    <td>@item.MaDatPhong</td>
                    <td>@item.DatPhong?.KhachHang?.TenKhachHang</td>
                    <td>@item.NgayLap.ToString("dd/MM/yyyy")</td>
                    <td>@item.TongTien.ToString("N0") VND</td>
                    <td>@item.ThanhToanTien.ToString("N0") VND</td>
                    <td>
                        @{
                            var badgeClass = item.TrangThai switch {
                                "PAID" => "bg-success",
                                "UNPAID" => "bg-danger",
                                "PARTIAL" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@item.TrangThai</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaHoaDon" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted text-center">Không có hóa đơn nào.</p>
}

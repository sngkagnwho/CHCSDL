@model doan.Models.HoaDon
@{
    ViewData["Title"] = "Chi Tiết Hóa Đơn";
}

<h2>🧾 Chi Tiết Hóa Đơn #@Model.MaHoaDon</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Khách Hàng:</dt>
    <dd class="col-sm-9">@Model.DatPhong?.KhachHang?.TenKhachHang</dd>
    <dt class="col-sm-3">Mã Đặt Phòng:</dt>
    <dd class="col-sm-9">@Model.MaDatPhong</dd>
    <dt class="col-sm-3">Ngày Lập:</dt>
    <dd class="col-sm-9">@Model.NgayLap.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Tổng Tiền:</dt>
    <dd class="col-sm-9">@Model.TongTien.ToString("N0") VND</dd>
    <dt class="col-sm-3">Giảm Giá:</dt>
    <dd class="col-sm-9">@Model.GiamGia%</dd>
    <dt class="col-sm-3">Thuế VAT:</dt>
    <dd class="col-sm-9">@Model.ThueVat%</dd>
    <dt class="col-sm-3">Đã Thanh Toán:</dt>
    <dd class="col-sm-9">@Model.ThanhToanTien.ToString("N0") VND</dd>
    <dt class="col-sm-3">Còn Lại:</dt>
    <dd class="col-sm-9"><strong>@((Model.TongTien - Model.ThanhToanTien).ToString("N0")) VND</strong></dd>
    <dt class="col-sm-3">Trạng Thái:</dt>
    <dd class="col-sm-9"><span class="badge bg-info">@Model.TrangThai</span></dd>
    <dt class="col-sm-3">Ghi Chú:</dt>
    <dd class="col-sm-9">@Model.GhiChu</dd>
</dl>

@if (Model.ThanhToans?.Any() == true)
{
    <h5 class="mt-3">Lịch Sử Thanh Toán</h5>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Ngày TT</th>
                <th>Số Tiền</th>
                <th>Phương Thức</th>
                <th>Ghi Chú</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tt in Model.ThanhToans)
            {
                <tr>
                    <td>@tt.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                    <td>@tt.SoTien.ToString("N0") VND</td>
                    <td>@tt.PhuongThuc</td>
                    <td>@tt.GhiChu</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.MaHoaDon" class="btn btn-warning">✏️ Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

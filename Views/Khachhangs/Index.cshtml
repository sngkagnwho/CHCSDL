@model IEnumerable<doan.Models.Khachhang>

@{
    ViewData["Title"] = "Danh Sách Khách Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people-fill me-2"></i>Danh Sách Khách Hàng</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Thêm Khách Hàng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <input type="text" name="search" value="@ViewBag.Search"
                       class="form-control" placeholder="Tìm theo tên, SĐT, email, CCCD..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Xóa bộ lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã KH</th>
                        <th>Họ Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Email</th>
                        <th>CCCD</th>
                        <th>Ngày Tạo</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaKhachHang</td>
                            <td><strong>@item.HoTen</strong></td>
                            <td>@(item.SoDienThoai ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td>@(item.CCCD ?? "-")</td>
                            <td>@(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.MaKhachHang"
                                   class="btn btn-sm btn-warning me-1" title="Sửa">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaKhachHang"
                                   class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                                Không có dữ liệu khách hàng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted">
        Tổng số: <strong>@Model.Count()</strong> khách hàng
    </div>
</div>

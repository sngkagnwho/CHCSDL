@model doan.Models.ProcedureInfo
@{
    ViewData["Title"] = "Thực Thi - " + Model.ProcedureName;
    var result = ViewBag.Result as doan.Models.ExecutionResult;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Procedures</a></li>
            <li class="breadcrumb-item active">@Model.ProcedureName</li>
        </ol>
    </nav>
    <h2><i class="bi bi-play-circle-fill text-primary me-2"></i>Thực Thi Procedure</h2>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 font-monospace text-primary">@Model.Icon @Model.ProcedureName</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">@Model.Description</p>

                <form method="post" asp-action="Execute" asp-route-name="@Model.ProcedureName">
                    @if (Model.ProcedureName == "sp_tinh_doanh_thu_ngay")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn Ngày <span class="badge bg-info">DATE</span></label>
                            <input type="date" name="p_ngay" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <small class="text-muted">Nhập ngày cần tính doanh thu</small>
                        </div>
                    }
                    else if (Model.ProcedureName == "sp_tinh_doanh_thu_thang" || 
                             Model.ProcedureName == "sp_tinh_luong_nhanvien" ||
                             Model.ProcedureName == "sp_cap_nhat_baocao")
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">Tháng <span class="badge bg-info">NUMBER</span></label>
                                <select name="p_thang" class="form-select">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(m == DateTime.Today.Month)">Tháng @m</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Năm <span class="badge bg-info">NUMBER</span></label>
                                <input type="number" name="p_nam" class="form-control" value="@DateTime.Today.Year" min="2020" max="2030" />
                            </div>
                        </div>
                    }
                    else if (Model.ProcedureName == "sp_thong_ke_phong_trong")
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Procedure này không có tham số đầu vào. Sẽ thống kê trạng thái phòng hiện tại.
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-play-fill me-1"></i>Thực Thi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Quay Lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        @if (result != null)
        {
            <div class="card @(result.Success ? "border-success" : "border-danger")">
                <div class="card-header @(result.Success ? "bg-success" : "bg-danger") text-white">
                    <h5 class="mb-0">
                        @if (result.Success)
                        {
                            <i class="bi bi-check-circle-fill me-2"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill me-2"></i>
                        }
                        Kết Quả Thực Thi
                    </h5>
                </div>
                <div class="card-body">
                    <p class="@(result.Success ? "text-success" : "text-danger")">
                        <i class="bi bi-info-circle me-1"></i>@result.Message
                    </p>
                    
                    @if (result.OutputValues?.Count > 0)
                    {
                        <h6 class="text-muted text-uppercase small mt-3 mb-2">Output Parameters</h6>
                        <div class="row g-2">
                            @foreach (var kv in result.OutputValues)
                            {
                                <div class="col-12">
                                    <div class="bg-light rounded p-3 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-muted">@kv.Key</span>
                                        <span class="fs-5 fw-bold text-primary">@kv.Value</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="mt-3 text-muted small">
                        <i class="bi bi-clock me-1"></i>Thực thi lúc @result.ExecutedAt.ToString("HH:mm:ss") 
                        | Thời gian: @result.ExecutionTimeMs ms
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card bg-light">
                <div class="card-body text-center py-5">
                    <i class="bi bi-play-circle text-muted" style="font-size:4rem;"></i>
                    <p class="text-muted mt-3">Điền thông tin và nhấn <strong>Thực Thi</strong> để xem kết quả</p>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-header bg-dark text-white">
                <small>Tham Số Thủ Tục</small>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-secondary">
                        <tr><th>Tham Số</th><th>Kiểu</th><th>Hướng</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Parameters)
                        {
                            <tr>
                                <td class="font-monospace small">@p.Name</td>
                                <td><span class="badge bg-light text-dark">@p.DataType</span></td>
                                <td>
                                    @if (p.Direction == "IN") { <span class="badge bg-info">IN</span> }
                                    else if (p.Direction == "OUT") { <span class="badge bg-warning text-dark">OUT</span> }
                                    else { <span class="badge bg-secondary">IN/OUT</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

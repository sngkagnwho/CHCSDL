@model IEnumerable<doan.Models.Phong>

@{
    ViewData["Title"] = "Danh Sách Phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-door-open-fill me-2"></i>Danh Sách Phòng</h2>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="form-label mb-0 fw-semibold">Lọc theo trạng thái:</label>
            </div>
            <div class="col-auto">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    <option value="AVAILABLE" selected="@(ViewBag.Status == "AVAILABLE")">Trống</option>
                    <option value="OCCUPIED" selected="@(ViewBag.Status == "OCCUPIED")">Đã thuê</option>
                    <option value="MAINTENANCE" selected="@(ViewBag.Status == "MAINTENANCE")">Bảo trì</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var phong in Model)
    {
        var badgeClass = phong.TrangThai switch
        {
            "AVAILABLE" => "bg-success",
            "OCCUPIED" => "bg-danger",
            "MAINTENANCE" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
        var statusLabel = phong.TrangThai switch
        {
            "AVAILABLE" => "Trống",
            "OCCUPIED" => "Đã thuê",
            "MAINTENANCE" => "Bảo trì",
            _ => phong.TrangThai ?? "N/A"
        };

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Phòng @phong.SoPhong</strong>
                    <span class="badge @badgeClass">@statusLabel</span>
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        <i class="bi bi-tag me-1"></i>
                        <strong>Loại:</strong> @(phong.LoaiPhong?.TenLoaiPhong ?? "N/A")
                    </p>
                    <p class="mb-1">
                        <i class="bi bi-building me-1"></i>
                        <strong>Tầng:</strong> @(phong.Tang?.ToString() ?? "N/A")
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-currency-dollar me-1"></i>
                        <strong>Giá:</strong>
                        @if (phong.Gia.HasValue)
                        {
                            @phong.Gia.Value.ToString("N0") <text> VNĐ/đêm</text>
                        }
                        else if (phong.LoaiPhong?.GiaCoban.HasValue == true)
                        {
                            @phong.LoaiPhong.GiaCoban.Value.ToString("N0") <text> VNĐ/đêm</text>
                        }
                        else
                        {
                            <text>N/A</text>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-4">
            <i class="bi bi-inbox fs-4 d-block mb-1"></i>Không có dữ liệu phòng.
        </div>
    }
</div>

<div class="mt-3 text-muted">
    Tổng số: <strong>@Model.Count()</strong> phòng
</div>

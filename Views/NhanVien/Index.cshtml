@model IEnumerable<doan.Models.NhanVien>
@{
    ViewData["Title"] = "Danh Sách Nhân Viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👷 Danh Sách Nhân Viên</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm Nhân Viên</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, chức vụ..." />
        <button class="btn btn-primary" type="submit">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Họ Tên</th>
                <th>Chức Vụ</th>
                <th>Số ĐT</th>
                <th>Email</th>
                <th>Lương</th>
                <th>Trạng Thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaNhanVien</td>
                    <td>@item.TenNhanVien</td>
                    <td>@item.ChucVu</td>
                    <td>@item.Sdt</td>
                    <td>@item.Email</td>
                    <td>@item.Luong.ToString("N0") VND</td>
                    <td>
                        <span class="badge @(item.TrangThai == "ACTIVE" ? "bg-success" : "bg-secondary")">@item.TrangThai</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted text-center">Không có nhân viên nào.</p>
}

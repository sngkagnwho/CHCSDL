@model Dictionary<string, int>
@{
    ViewData["Title"] = "Database Info";
}

<div class="mb-4">
    <h2 class="mb-1"><i class="bi bi-database text-secondary me-2"></i>Database Information</h2>
    <p class="text-muted">Thông tin tổng quan về Oracle Database</p>
</div>

<!-- Connection Status -->
<div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-info-circle-fill me-3 fs-4"></i>
    <div>
        <strong>Oracle Database Connection</strong><br>
        <small>User: MANA | Service: orcl | Host: localhost:1521</small>
        <span class="badge bg-warning text-dark ms-2">Demo Mode</span>
    </div>
</div>

<!-- Stats Grid -->
<div class="row g-3 mb-4">
    @foreach (var stat in Model)
    {
        var iconColor = stat.Key switch
        {
            "Tables" => ("bi-table", "primary"),
            "Views" => ("bi-eye", "info"),
            "Procedures" => ("bi-gear-fill", "warning"),
            "Functions" => ("bi-code-slash", "success"),
            "Triggers" => ("bi-lightning-charge-fill", "danger"),
            "Packages" => ("bi-box-seam", "secondary"),
            "Indexes" => ("bi-list-ol", "dark"),
            "Sequences" => ("bi-123", "primary"),
            _ => ("bi-question", "secondary")
        };
        <div class="col-xl-3 col-md-4 col-6">
            <div class="card stat-card text-center h-100">
                <div class="card-body">
                    <i class="bi @iconColor.Item1 text-@iconColor.Item2" style="font-size:2rem;"></i>
                    <div class="fw-bold fs-3 text-@iconColor.Item2 mt-2">@stat.Value</div>
                    <div class="text-muted">@stat.Key</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <!-- Oracle Objects Bar Chart -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Phân Bổ Database Objects</h5>
            </div>
            <div class="card-body">
                <canvas id="dbChart" height="120"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Quick Links -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Truy Cập Nhanh</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <a asp-controller="Procedures" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-gear-fill text-primary me-2"></i>Xem Procedures (@Model.GetValueOrDefault("Procedures"))
                    </a>
                    <a asp-controller="Triggers" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Xem Triggers (@Model.GetValueOrDefault("Triggers"))
                    </a>
                    <a asp-controller="Functions" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-code-slash text-success me-2"></i>Xem Functions (@Model.GetValueOrDefault("Functions"))
                    </a>
                    <a asp-controller="Packages" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-box-seam text-info me-2"></i>Xem Packages (@Model.GetValueOrDefault("Packages"))
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="bi bi-speedometer2 text-secondary me-2"></i>Dashboard Tổng Quan
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const labels = [@Html.Raw(string.Join(",", Model.Keys.Select(k => $"'{k}'")))];
    const data = [@Html.Raw(string.Join(",", Model.Values))];
    const colors = ['#0d6efd','#0dcaf0','#ffc107','#198754','#dc3545','#6c757d','#212529','#0d6efd'];

    new Chart(document.getElementById('dbChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Số Lượng',
                data: data,
                backgroundColor: colors.map(c => c + 'b3'),
                borderColor: colors,
                borderWidth: 2,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 2 } } }
        }
    });
</script>
}

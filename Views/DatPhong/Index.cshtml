@model IEnumerable<doan.Models.DatPhong>
@{
    ViewData["Title"] = "Danh Sách Đặt Phòng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 Danh Sách Đặt Phòng</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm Đặt Phòng</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <select name="trangThai" asp-items="@ViewBag.TrangThaiList" class="form-select" style="max-width: 220px;">
        <option value="">-- Tất cả trạng thái --</option>
    </select>
    <button class="btn btn-primary" type="submit">Lọc</button>
    @if (!string.IsNullOrWhiteSpace(ViewBag.TrangThai as string))
    {
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa lọc</a>
    }
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Khách Hàng</th>
                <th>Ngày Đặt</th>
                <th>Check-in</th>
                <th>Check-out</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaDatPhong</td>
                    <td>@item.KhachHang?.TenKhachHang</td>
                    <td>@item.NgayDatPhong.ToString("dd/MM/yyyy")</td>
                    <td>@item.NgayCheckIn.ToString("dd/MM/yyyy")</td>
                    <td>@item.NgayCheckOut.ToString("dd/MM/yyyy")</td>
                    <td>@item.TongTien?.ToString("N0") VND</td>
                    <td>
                        @{
                            var badgeClass = item.TrangThai switch {
                                "CONFIRMED" => "bg-success",
                                "PENDING" => "bg-warning text-dark",
                                "CANCELLED" => "bg-danger",
                                "CHECKED_IN" => "bg-primary",
                                "CHECKED_OUT" => "bg-secondary",
                                _ => "bg-info"
                            };
                        }
                        <span class="badge @badgeClass">@item.TrangThai</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaDatPhong" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted text-center">Không có đặt phòng nào.</p>
}

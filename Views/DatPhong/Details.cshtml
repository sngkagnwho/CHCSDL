@model doan.Models.DatPhong
@{
    ViewData["Title"] = "Chi Tiết Đặt Phòng";
}

<h2>📋 Chi Tiết Đặt Phòng #@Model.MaDatPhong</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Khách Hàng:</dt>
    <dd class="col-sm-9">@Model.KhachHang?.TenKhachHang</dd>
    <dt class="col-sm-3">Ngày Đặt:</dt>
    <dd class="col-sm-9">@Model.NgayDatPhong.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Check-in:</dt>
    <dd class="col-sm-9">@Model.NgayCheckIn.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Check-out:</dt>
    <dd class="col-sm-9">@Model.NgayCheckOut.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Tổng Tiền:</dt>
    <dd class="col-sm-9">@Model.TongTien?.ToString("N0") VND</dd>
    <dt class="col-sm-3">Trạng Thái:</dt>
    <dd class="col-sm-9"><span class="badge bg-info">@Model.TrangThai</span></dd>
    <dt class="col-sm-3">Ghi Chú:</dt>
    <dd class="col-sm-9">@Model.GhiChu</dd>
</dl>

@if (Model.ChiTietDatPhongs?.Any() == true)
{
    <h5 class="mt-3">Chi Tiết Phòng Đặt</h5>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Số Phòng</th>
                <th>Loại Phòng</th>
                <th>Giá Thuê</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.ChiTietDatPhongs)
            {
                <tr>
                    <td>@ct.Phong?.SoPhong</td>
                    <td>@ct.Phong?.LoaiPhong?.TenLoaiPhong</td>
                    <td>@ct.GiaThue.ToString("N0") VND</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.MaDatPhong" class="btn btn-warning">✏️ Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

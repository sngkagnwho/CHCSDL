@model doan.Models.DatPhong
@{
    ViewData["Title"] = "Sửa Đặt Phòng";
}

<h2>✏️ Sửa Đặt Phòng</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDatPhong" />

            <div class="mb-3">
                <label asp-for="MaKhachHang" class="form-label"></label>
                <select asp-for="MaKhachHang" asp-items="@ViewBag.KhachHangList" class="form-select">
                    <option value="">-- Chọn khách hàng --</option>
                </select>
                <span asp-validation-for="MaKhachHang" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayDatPhong" class="form-label"></label>
                <input asp-for="NgayDatPhong" class="form-control" type="date" />
                <span asp-validation-for="NgayDatPhong" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayCheckIn" class="form-label"></label>
                <input asp-for="NgayCheckIn" class="form-control" type="date" />
                <span asp-validation-for="NgayCheckIn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayCheckOut" class="form-label"></label>
                <input asp-for="NgayCheckOut" class="form-control" type="date" />
                <span asp-validation-for="NgayCheckOut" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="PENDING">PENDING</option>
                    <option value="CONFIRMED">CONFIRMED</option>
                    <option value="CHECKED_IN">CHECKED_IN</option>
                    <option value="CHECKED_OUT">CHECKED_OUT</option>
                    <option value="CANCELLED">CANCELLED</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TongTien" class="form-label"></label>
                <input asp-for="TongTien" class="form-control" type="number" step="1000" />
                <span asp-validation-for="TongTien" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">💾 Cập Nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

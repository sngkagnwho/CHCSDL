@model doan.Models.DatPhong
@{
    ViewData["Title"] = "Thêm Đặt Phòng";
}

<h2>📋 Thêm Đặt Phòng</h2>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MaKhachHang" class="form-label"></label>
                <select asp-for="MaKhachHang" asp-items="@ViewBag.KhachHangList" class="form-select">
                    <option value="">-- Chọn khách hàng --</option>
                </select>
                <span asp-validation-for="MaKhachHang" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayDatPhong" class="form-label"></label>
                <input asp-for="NgayDatPhong" class="form-control" type="date" />
                <span asp-validation-for="NgayDatPhong" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayCheckIn" class="form-label"></label>
                <input asp-for="NgayCheckIn" class="form-control" type="date" />
                <span asp-validation-for="NgayCheckIn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NgayCheckOut" class="form-label"></label>
                <input asp-for="NgayCheckOut" class="form-control" type="date" />
                <span asp-validation-for="NgayCheckOut" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="PENDING">PENDING</option>
                    <option value="CONFIRMED">CONFIRMED</option>
                    <option value="CHECKED_IN">CHECKED_IN</option>
                    <option value="CHECKED_OUT">CHECKED_OUT</option>
                    <option value="CANCELLED">CANCELLED</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Chọn Phòng</label>
                <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var phong in (ViewBag.PhongList as SelectList ?? Enumerable.Empty<SelectListItem>()))
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedPhongs" value="@phong.Value" id="phong_@phong.Value" />
                            <label class="form-check-label" for="phong_@phong.Value">@phong.Text</label>
                        </div>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">💾 Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model IEnumerable<doan.Models.KhachHang>
@{
    ViewData["Title"] = "Danh Sách Khách Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👤 Danh Sách Khách Hàng</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm Khách Hàng</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên, CMND, SĐT..." />
        <button class="btn btn-primary" type="submit">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Xóa</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Họ Tên</th>
                <th>CMND/CCCD</th>
                <th>Số ĐT</th>
                <th>Email</th>
                <th>Quốc Tịch</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaKhachHang</td>
                    <td>@item.TenKhachHang</td>
                    <td>@item.Cmnd</td>
                    <td>@item.Sdt</td>
                    <td>@item.Email</td>
                    <td>@item.QuocTich</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaKhachHang" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted text-center">Không có khách hàng nào.</p>
}
